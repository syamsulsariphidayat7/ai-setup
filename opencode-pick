#!/usr/bin/env bash
# ============================================================================
# opencode-pick — pilih combo model secara otomatis per proyek
#
# Menganalisis kompleksitas proyek (file, LOC, bahasa, framework, test, git)
# lalu merekomendasikan combo:
#   ops-free   : tugas ringan            (agentrouter/gpt-5.6-sol → oc/deepseek-v4-flash-free → oc/mimo-v2.5-free)
#   ops-dev    : coding rutin            (agentrouter/gpt-5.6-sol → agentrouter/claude-opus-4-8 → oc/deepseek-v4-flash-free → oc/mimo-v2.5-free)
#   ops-pro    : fitur berat             (agentrouter/claude-opus-4-8 → agentrouter/gpt-5.6-sol → oc/deepseek-v4-flash-free → oc/mimo-v2.5-free)
#   ops-plan   : awal proyek / arsitektur (agentrouter/claude-opus-4-8 → agentrouter/gpt-5.6-sol → oc/deepseek-v4-flash-free → oc/mimo-v2.5-free)
#
# Penggunaan:
#   opencode-pick                      # rekomendasi + buka opencode TUI
#   opencode-pick run "pesan"          # opencode run dengan combo terpilih
#   opencode-pick -c                   # lanjut sesi terakhir
#   opencode-pick --print              # hanya print nama combo
#   opencode-pick --model-only         # print omniroute/<combo>
#   opencode-pick --combo ops-pro      # paksa combo tertentu
#   opencode-pick --help
#
# Override per proyek: simpan file `.opencode-combo` di root proyek (mis. "ops-pro")
# atau set env `OC_COMBO`.
# ============================================================================
set -euo pipefail

VERSION="2.0.0"
TIER_ORDER=(ops-free ops-dev ops-pro ops-plan)
PROVIDER="omniroute"

declare -A COMBO_TIER=(
  [ops-free]="ringan"
  [ops-dev]="menengah"
  [ops-pro]="berat"
  [ops-plan]="paling pintar"
)
declare -A COMBO_CHAIN=(
  [ops-free]="agentrouter/gpt-5.6-sol → oc/deepseek-v4-flash-free → oc/mimo-v2.5-free"
  [ops-dev]="agentrouter/gpt-5.6-sol → agentrouter/claude-opus-4-8 → oc/deepseek-v4-flash-free → oc/mimo-v2.5-free"
  [ops-pro]="agentrouter/claude-opus-4-8 → agentrouter/gpt-5.6-sol → oc/deepseek-v4-flash-free → oc/mimo-v2.5-free"
  [ops-plan]="agentrouter/claude-opus-4-8 → agentrouter/gpt-5.6-sol → oc/deepseek-v4-flash-free → oc/mimo-v2.5-free"
)

SOURCE_EXTS="\.(ts|tsx|js|jsx|mjs|cjs|py|rb|go|rs|java|kt|c|cpp|cc|h|hpp|cs|php|vue|svelte|swift|scala|hs|lua|r|pl|sh|bash|zsh|sql|graphql|proto|html|css|scss|less)$"

err() { echo "❌ $*" >&2; }

usage() {
  awk 'NR==1 {next} /^# ====/ {if (++c == 2) exit; next} {sub(/^# ?/, ""); print}' "$0"
  exit 0
}

# ---------------------------------------------------------------------------
# Analisis proyek
# ---------------------------------------------------------------------------
analyze_project() {
  local dir="$1"
  local -a file_list
  local total_files=0 total_loc=0
  local -A lang_count=()
  local has_test=0 has_framework=0 framework_name=""
  local deps_count=0 git_commits=0

  mapfile -t file_list < <(
    find "$dir" \
      \( -path "$dir/.git" -o -path "$dir/node_modules" -o -path "$dir/vendor" \
         -o -path "$dir/dist" -o -path "$dir/build" -o -path "$dir/target" \
         -o -path "$dir/__pycache__" -o -path "$dir/.venv" -o -path "$dir/venv" \
         -o -path "$dir/.next" -o -path "$dir/.cache" \) -prune -o \
      -type f -regextype posix-extended -iregex ".*${SOURCE_EXTS}" -print 2>/dev/null \
    | head -2000
  )
  total_files="${#file_list[@]}"

  for f in "${file_list[@]}"; do
    if [[ "$f" == *.* ]]; then
      local ext="${f##*.}"
      ext="${ext,,}"
      [[ -n "${ext}" ]] && lang_count["${ext}"]=$(( ${lang_count["${ext}"]:-0} + 1 ))
    fi
    local n
    n=$(wc -l < "$f" 2>/dev/null || echo 0)
    total_loc=$(( total_loc + n ))
  done

  local lang_kinds="${#lang_count[@]}"

  # test suite?
  if find "$dir" -maxdepth 4 -type f \( -name "*.test.ts" -o -name "*.test.js" -o -name "*.spec.ts" -o -name "*.spec.js" -o -name "test_*.py" -o -name "*_test.go" \) \
       -not -path "$dir/node_modules*" 2>/dev/null | grep -q .; then
    has_test=1
  fi

  # framework / dependensi
  if [[ -f "$dir/package.json" ]]; then
    has_framework=1
    deps_count=$(DIR="$dir" python3 -c '
import json, os
try:
    d=json.load(open(os.path.join(os.environ["DIR"], "package.json")))
    deps={**d.get("dependencies",{}),**d.get("devDependencies",{})}
    print(len(deps))
except Exception:
    print(0)' 2>/dev/null || echo 0)
    framework_name="node ($deps_count deps)"
  elif [[ -f "$dir/requirements.txt" ]]; then
    deps_count=$(grep -vcE '^\s*(#|$)' "$dir/requirements.txt" 2>/dev/null || echo 0)
    framework_name="python ($deps_count deps)"
    has_framework=1
  elif [[ -f "$dir/go.mod" ]]; then
    framework_name="go"
    has_framework=1
  elif [[ -f "$dir/Cargo.toml" ]]; then
    framework_name="rust"
    has_framework=1
  fi

  # git history
  if [[ -d "$dir/.git" ]]; then
    git_commits=$(git -C "$dir" rev-list --count HEAD 2>/dev/null || echo 0)
  fi

  # SKOR kompleksitas (0-100)
  local score=0

  # ukuran file (0-20)
  if   [[ $total_files -eq 0 ]];        then score=$((score + 0))
  elif [[ $total_files -lt 5 ]];        then score=$((score + 3))
  elif [[ $total_files -lt 20 ]];       then score=$((score + 8))
  elif [[ $total_files -lt 80 ]];       then score=$((score + 14))
  else                                       score=$((score + 20))
  fi

  # LOC (0-20)
  if   [[ $total_loc -lt 100 ]];        then score=$((score + 1))
  elif [[ $total_loc -lt 500 ]];        then score=$((score + 6))
  elif [[ $total_loc -lt 3000 ]];       then score=$((score + 12))
  elif [[ $total_loc -lt 15000 ]];      then score=$((score + 17))
  else                                       score=$((score + 20))
  fi

  # ragam bahasa (0-15)
  if   [[ $lang_kinds -ge 6 ]];         then score=$((score + 15))
  elif [[ $lang_kinds -ge 4 ]];         then score=$((score + 11))
  elif [[ $lang_kinds -ge 2 ]];         then score=$((score + 6))
  else                                       score=$((score + 1))
  fi

  # framework & dependensi (0-15)
  if [[ $has_framework -eq 1 ]]; then
    if   [[ $deps_count -ge 50 ]];      then score=$((score + 15))
    elif [[ $deps_count -ge 15 ]];      then score=$((score + 11))
    elif [[ $deps_count -ge 5 ]];       then score=$((score + 7))
    else                                     score=$((score + 3))
    fi
  fi

  # test suite (0-10)
  [[ $has_test -eq 1 ]] && score=$((score + 10))

  # git maturity (0-10)
  if [[ $git_commits -ge 200 ]];        then score=$((score + 10))
  elif [[ $git_commits -ge 50 ]];       then score=$((score + 7))
  elif [[ $git_commits -ge 10 ]];       then score=$((score + 4))
  elif [[ $git_commits -ge 1 ]];        then score=$((score + 1))
  fi

  RESULT_SCORE=$score
  RESULT_FILES=$total_files
  RESULT_LOC=$total_loc
  RESULT_LANGS=$lang_kinds
  RESULT_TEST=$has_test
  RESULT_FW="$framework_name"
  RESULT_DEPS=$deps_count
  RESULT_COMMITS=$git_commits
}

pick_combo() {
  local score=$1
  if   [[ $score -le 15 ]]; then echo "ops-free"
  elif [[ $score -le 30 ]]; then echo "ops-dev"
  elif [[ $score -le 55 ]]; then echo "ops-pro"
  else                           echo "ops-plan"
  fi
}

# ---------------------------------------------------------------------------
# MAIN
# ---------------------------------------------------------------------------
MODE="tui"
FORCE_COMBO=""
RUN_ARGS=()
TARGET_DIR="$(pwd)"

ARGS=("$@")
i=0
while [[ $i -lt ${#ARGS[@]} ]]; do
  a="${ARGS[$i]}"
  case "$a" in
    --help|-h) usage ;;
    --version) echo "opencode-pick v${VERSION}"; exit 0 ;;
    --print) MODE="print" ;;
    --model-only) MODE="model-only" ;;
    --combo) i=$((i+1)); FORCE_COMBO="${ARGS[$i]:-}" ;;
    run) MODE="run" ;;
    -c|--continue) CONTINUE=1 ;;
    --dir) i=$((i+1)); TARGET_DIR="${ARGS[$i]:-}" ;;
    *)
      if [[ $MODE == "run" ]]; then
        RUN_ARGS+=("$a")
      else
        err "Argumen tidak dikenal: $a (lihat --help)"
        exit 1
      fi
      ;;
  esac
  i=$((i+1))
done

[[ $MODE == "run" && ${#RUN_ARGS[@]} -eq 0 ]] && { err "Mode run butuh prompt: opencode-pick run \"pesan\""; exit 1; }
[[ ! -d "$TARGET_DIR" ]] && { err "Direktori tidak ditemukan: $TARGET_DIR"; exit 1; }

# resolve combo
COMBO=""
if [[ -n "$FORCE_COMBO" ]]; then
  COMBO="$FORCE_COMBO"
elif [[ -n "${OC_COMBO:-}" ]]; then
  COMBO="$OC_COMBO"
elif [[ -f "$TARGET_DIR/.opencode-combo" ]]; then
  COMBO=$(tr -d '[:space:]' < "$TARGET_DIR/.opencode-combo")
fi

analyze_project "$TARGET_DIR"

if [[ -z "$COMBO" ]]; then
  COMBO=$(pick_combo "$RESULT_SCORE")
fi

[[ -z "${COMBO_TIER[$COMBO]:-}" ]] && { err "Combo tidak dikenal: '$COMBO'. Pilihan: ops-free | ops-dev | ops-pro | ops-plan"; exit 1; }

CONTINUE="${CONTINUE:-0}"

case "$MODE" in
  print) echo "$COMBO" ;;
  model-only) echo "$PROVIDER/$COMBO" ;;
  run)
    echo "→ ${PROVIDER}/${COMBO} (${COMBO_TIER[$COMBO]}): ${COMBO_CHAIN[$COMBO]}"
    cd "$TARGET_DIR"
    if [[ $CONTINUE -eq 1 ]]; then
      opencode run -c --model "${PROVIDER}/${COMBO}" "${RUN_ARGS[@]}"
    else
      opencode run --model "${PROVIDER}/${COMBO}" "${RUN_ARGS[@]}"
    fi
    ;;
  tui)
    echo "============================================================"
    echo "  📊 $(basename "$TARGET_DIR")  |  skor ${RESULT_SCORE}"
    echo "     ${RESULT_FILES} file · ${RESULT_LOC} baris · ${RESULT_LANGS} bahasa"
    [[ $RESULT_TEST -eq 1 ]] && echo "     ✅ test suite" || echo "     ❌ tanpa test"
    [[ -n "$RESULT_FW" ]] && echo "     📦 $RESULT_FW"
    [[ $RESULT_COMMITS -gt 0 ]] && echo "     🔀 $RESULT_COMMITS commit"
    echo "------------------------------------------------------------"
    echo "  🎯 ${PROVIDER}/${COMBO}  (${COMBO_TIER[$COMBO]})"
    echo "     ${COMBO_CHAIN[$COMBO]}"
    echo "============================================================"
    cd "$TARGET_DIR"
    if [[ $CONTINUE -eq 1 ]]; then
      opencode -c --model "${PROVIDER}/${COMBO}"
    else
      opencode --model "${PROVIDER}/${COMBO}"
    fi
    ;;
esac
